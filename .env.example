# SAGE — Environment Configuration
# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.

# ── Mock AI toggle ───────────────────────────────────────────────
# Set to "false" to use the real modules instead of mocks.
USE_MOCK_AI=true

# Per-module overrides (uncomment to override the global flag):
# USE_MOCK_ANALYZER=true
# USE_MOCK_RAG=true
# USE_MOCK_TUTOR=true

# ── LLM provider (shared by analyzer & tutor) ───────────────────
# Provider: gemini | openai | groq | ollama
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# ── Database ─────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///./sage.db
